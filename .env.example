# Порт приложения
PORT=5000

# Секрет для JWT (обязательно замените на свой)
JWT_SECRET=change_me

# MySQL — основной вариант (Replit и обычный хостинг).
# Можно указать одной строкой:
DATABASE_URL=mysql://user:password@host:3306/foodboom
# ...или отдельными переменными:
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=foodboom
# MYSQL_PASSWORD=secret
# MYSQL_DATABASE=foodboom
# MYSQL_SSL=1

# SQLite — только для локального запуска без MySQL
# DB_PATH=foodboom.db
