run = "npm start"
entrypoint = "server.js"
modules = ["nodejs-22"]
hidden = [".config", ".git", "node_modules", "foodboom.db", "foodboom.db-shm", "foodboom.db-wal"]

[nix]
channel = "stable-24_11"

[env]
PORT = "5000"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
build = ["npm", "install"]
run = ["npm", "start"]
deploymentTarget = "gce"
